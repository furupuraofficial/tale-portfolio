# Required for the OpenAI Realtime mode
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# HTTP server
PORT=8080
# Comma-separated browser origins allowed to open /ws. Same-origin and native
# clients without an Origin header are accepted automatically.
TALE_ALLOWED_ORIGINS=http://localhost:3000

# Required only for the Gemini mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: enables lesson APIs backed by PostgreSQL
DATABASE_URL=postgres://tale:tale@localhost:5432/tale?sslmode=disable

# Optional debugging flags
REALTIME_DEBUG=0
DEBUG_GEMINI=false
